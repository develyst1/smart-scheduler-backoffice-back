# Shared PostgreSQL (same DB as smart-scheduler-back; migrations use schema `ops` only)
DATABASE_URL=postgresql://user:pass@localhost:5432/smart_backoffice_db

# Backoffice API port (scheduling API defaults to 4006)
PORT=4010

# Admin auth (SPEC-003). Login (POST /api/v1/auth/login) checks these; token is HS256 JWT.
# Dev fallback is admin/admin. PROD: set real values AND SKIP_ADMIN_AUTH=false.
JWT_SECRET=change-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
JWT_TTL_SECONDS=43200
# Dev bypass for admin-guarded routes; MUST be false in prod so login is enforced.
SKIP_ADMIN_AUTH=true

# Service token for smart-scheduler-back and other consumers
SERVICE_TOKEN=change-me-service-token

# LINE (optional — parent notify on account debit)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
