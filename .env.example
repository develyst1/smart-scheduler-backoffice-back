# Shared PostgreSQL (same DB as smart-scheduler-back; migrations use schema `ops` only)
DATABASE_URL=postgresql://user:pass@localhost:5432/smart_scheduler

# Backoffice API port (scheduling API defaults to 3001)
PORT=3002

# Admin JWT (backoffice FE) — implement in auth middleware
JWT_SECRET=change-me

# Service token for smart-scheduler-back and other consumers
SERVICE_TOKEN=change-me-service-token

# LINE (optional — parent notify on account debit)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
