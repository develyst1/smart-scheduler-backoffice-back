# backoffice-back shares the scheduling database — `bo.*` lives alongside `public.*` in `smart_scheduler`.
# Do NOT use a separate DB (breaks the shared-DB / in-tx freelance design; `migrate:bo` needs to see
# `public.freelance_budgets`). The legacy `smart_backoffice_db` (ops-era) is retired.
DATABASE_URL=postgresql://user:pass@localhost:5432/smart_scheduler

# Backoffice API port (scheduling API defaults to 4006)
PORT=4010

# Sign-in (SPEC-003 / SPEC-097). POST /api/v1/auth/login validates against the bo.users table (roles ceo / admin / coach);
# the token is an HS256 JWT carrying {sub, role, teacherId}.
# Secret that signs and verifies every login token. PROD: a long random value, never the placeholder.
JWT_SECRET=change-me
# How long a login token lives, in seconds (43200 = 12 h).
JWT_TTL_SECONDS=43200
# Dev-only single admin login (admin/admin by default). It works ONLY while SKIP_ADMIN_AUTH=true; with auth enforced it is off.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Dev bypass for guarded routes (no token ⇒ a dev ceo; a valid Bearer still wins); MUST be false in prod so login is enforced.
SKIP_ADMIN_AUTH=true
# seed the CEO (พี่ฟีน) back-office user; owner sets on sid; unset ⇒ no CEO seed (dev stub only)
# BO_SEED_CEO_USERNAME=
# CEO seed password; hashed on first seed; owner sets on sid; never commit a real value
# BO_SEED_CEO_PASSWORD=

# Base URL the smoke test (`bun run smoke`) hits (default matches PORT)
API_BASE=http://localhost:4010

# Service token for smart-scheduler-back and other consumers. It also guards GET /api/v1/internal/salary/unconfirmed (the pay-confirm reminders read it): that route is FAIL-CLOSED, an empty value refuses every caller.
SERVICE_TOKEN=change-me-service-token

# TASK-887 (the CEO's «remind now»): where smart-scheduler-back is (its base URL, e.g. http://localhost:4006). EMPTY = remind-now makes no call (the list is still returned).
SCHEDULER_API_URL=
# TASK-887: the secret smart-scheduler-back expects as x-internal-secret on POST /internal/salary-remind-now — it MUST EQUAL that box's INTERNAL_JOB_SECRET. EMPTY = no call.
SCHEDULER_INTERNAL_SECRET=

# LINE (optional — parent notify on account debit)
# LINE_CHANNEL_ACCESS_TOKEN=
# LINE_CHANNEL_SECRET=
