{
  "name": "smart-scheduler-backoffice-back",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --compile --minify --outfile dist/smart-scheduler-backoffice-back",
    "start": "bun src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && bun run db:verify",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "db:seed-bo-ceo": "bun run src/db/seed-bo-ceo.ts",
    "seed": "bun run src/db/seed-bo-ceo.ts",
    "db:seed-salary-demo": "bun run src/db/seed-salary-demo.ts",
    "db:seed-demo-stock": "bun run src/db/seed-demo-stock.ts",
    "db:seed-notification-assignments": "bun run src/db/seed-notification-assignments.ts",
    "migrate:bo": "bun run src/db/migrate-to-bo.ts",
    "verify:bo": "bun run src/db/verify-bo-migration.ts",
    "smoke": "bun run scripts/smoke.ts",
    "test": "bun test",
    "db:verify": "bun run scripts/verify-migrations.ts",
    "db:seed-ledger": "bun run scripts/seed-ledger-from-schema.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.2",
    "exceljs": "4.4.0",
    "hono": "^4.12.26",
    "pdfkit": "0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  }
}
